# Kalendary - Environment Variables for Vercel Deployment
# Copy this file to .env.local for local development

# ==============================================================================
# DATABASE (Required)
# ==============================================================================
# Vercel Postgres connection string
# Get this from: Vercel Dashboard > Project > Storage > Postgres > .env.local tab
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NO_SSL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_USER="..."
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="..."

# ==============================================================================
# AUTHENTICATION (Required)
# ==============================================================================
# JWT Secret - use a strong random string (min 32 characters)
# Generate one with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# ==============================================================================
# AI FEATURES (Optional)
# ==============================================================================
# LM Studio endpoint for local AI (optional)
# LM_STUDIO_URL="http://localhost:1234/v1"

# OpenAI API key for cloud AI (optional)
# OPENAI_API_KEY="sk-..."
